# Example environment variables

# Server
PORT=8080
FRONTEND_ORIGIN=http://localhost:3000

# SQLite (recommended)
DATABASE_URL=file:./data/paywall.db?_busy_timeout=5000&_foreign_keys=1

# Stripe
# Prefer STRIPE_SECRET_KEY, STRIPE_KEY is supported for backward compat.
STRIPE_SECRET_KEY=sk_test_51NyaxCHgs5ykAQ5YJK002kbtIGnMWbdGwniKIqWQ9YVWy60vuvxuWDtWKEqSamMaqINoPhjukfEiegyQTX346bS800hQh9gCqJ
STRIPE_WEBHOOK_SECRET=whsec_...

# Where Stripe redirects the user after checkout
STRIPE_SUCCESS_URL=http://localhost:3000/success
STRIPE_CANCEL_URL=http://localhost:3000/cancel

# Option A (simplest + recommended): Use a pre-created Price (fixed amount)
STRIPE_PRICE_ID=price_...

# Option B: Dynamic amount (no STRIPE_PRICE_ID)
STRIPE_CURRENCY=usd
STRIPE_PRODUCT_NAME=Paywall payment

# Optional: Use your pre-created Product for dynamic pricing
STRIPE_PRODUCT_ID=prod_...
